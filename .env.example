# Reference of all environment variables. Use with `docker run --env-file .env`, or put the
# values in your MCP client config ("env" block). Never commit a filled-in copy.

# --- Kaggle credentials (one of these) -------------------------------------
# API token from https://www.kaggle.com/settings -> API -> "Generate New Token"
KAGGLE_API_TOKEN=
# ...or the legacy key pair (from kaggle.json):
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# --- Local file sandbox ------------------------------------------------------
# KAGGLE_MCP_WORKSPACE=~/kaggle-mcp-workspace
# KAGGLE_MCP_MAX_DOWNLOAD_MB=1024
# KAGGLE_MCP_MAX_UPLOAD_MB=512
# KAGGLE_MCP_MAX_OUTPUT_CHARS=60000

# --- Policy ----------------------------------------------------------------
# KAGGLE_MCP_READ_ONLY=false      # true = hide every tool that changes Kaggle state
# KAGGLE_MCP_ALLOW_DELETE=false   # true = expose notebook_delete / dataset_delete

# --- HTTP transport (remote: ChatGPT, claude.ai, APIs) ---------------------------
# KAGGLE_MCP_TRANSPORT=http
# KAGGLE_MCP_HOST=127.0.0.1
# KAGGLE_MCP_PORT=8000
# Required for HTTP. Generate with: kaggle-mcp generate-token
# KAGGLE_MCP_AUTH_TOKEN=
# Serve also at /s/<token>/mcp for clients that cannot send headers (URL becomes a secret):
# KAGGLE_MCP_ALLOW_PATH_TOKEN=false
# Public hostname(s) for Host-header (DNS rebinding) validation, comma separated:
# KAGGLE_MCP_ALLOWED_HOSTS=mcp.example.com
# KAGGLE_MCP_LOG_LEVEL=INFO
